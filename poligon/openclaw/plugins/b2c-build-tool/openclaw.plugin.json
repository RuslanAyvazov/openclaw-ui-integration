{
  "id": "b2c-build-tool",
  "name": "B2C Datamart Update Tool",
  "description": "Finds accessible datamarts, adds new streams, and extends existing stream columns from S2T.",
  "version": "3.0.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "skillRoot": {
        "type": "string",
        "minLength": 1
      },
      "backendBaseUrl": {
        "type": "string",
        "minLength": 1
      },
      "controlTokenFile": {
        "type": "string",
        "minLength": 1
      },
      "timeoutSeconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3600,
        "default": 900
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "b2c_list_accessible_datamarts",
      "b2c_update_mart_from_upload_path"
    ]
  },
  "toolMetadata": {
    "b2c_list_accessible_datamarts": {
      "optional": true
    },
    "b2c_update_mart_from_upload_path": {
      "optional": true
    }
  }
}
