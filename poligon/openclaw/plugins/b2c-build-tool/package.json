{
  "name": "openclaw-plugin-b2c-build-tool",
  "version": "3.0.0",
  "description": "OpenClaw tools for adding streams and extending existing stream attributes from S2T.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:validate": "npm run build && openclaw plugins validate --entry ./dist/index.js"
  },
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "dependencies": {
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "openclaw": "2026.7.1",
    "typescript": "5.9.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
