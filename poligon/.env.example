POSTGRES_DB=b2csql
POSTGRES_USER=b2csql
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=false
COOKIE_SECURE=false
UI_PORT=8088
BACKEND_PORT=8000
TZ=Europe/Moscow

# OpenClaw запускается самим Docker Compose. Токены пользователей сюда не записываются.
OPENCLAW_VERSION=2026.7.1-2
OPENCLAW_PROVIDER=custom-routerai-ru
OPENCLAW_PROVIDER_NAME=RouterAI
OPENCLAW_PROVIDER_BASE_URL=https://routerai.ru/api/v1
OPENCLAW_DEFAULT_MODEL=custom-routerai-ru/deepseek/deepseek-v4-pro
OPENCLAW_MODEL_NAME=DeepSeek V4 Pro
